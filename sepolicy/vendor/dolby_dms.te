# Dolby DMS (AIDL `vendor.dolby.dms.IDms/default`, servicio `dms-hal`).
#
# Los nombres de tipo y las reglas salen del firmware stock A16 (.64R): se
# sacaron de su vendor_sepolicy.cil y de su vendor_service_contexts. Se usan los
# mismos nombres a proposito, para no inventar etiquetas nuevas y para que el
# servicio, sus clientes y las props queden igual que en stock.
#
# Quien hace que: el efecto DAP (libswdap.so) lo carga audioserver, asi que va
# como cliente; libdmshal.so es la que hace las llamadas binder al servicio.
#
# No se reproduce nada de los codecs C2 (mediacodec como cliente) porque esos
# codecs no se instalan.

# --- Atributos (igual que en stock) ---
attribute hal_aidl_dms;
attribute hal_aidl_dms_client;
attribute hal_aidl_dms_server;

# --- Dominio del servicio ---
type hal_aidl_dms_default, domain;
type hal_aidl_dms_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_aidl_dms_default)
typeattribute hal_aidl_dms_default hal_aidl_dms;
typeattribute hal_aidl_dms_default hal_aidl_dms_server;

# Nombre AIDL del servicio (la etiqueta se asigna en service_contexts)
type hal_aidl_dms_service, service_manager_type;

# Props de Dolby (mismo tipo que en stock).
# vendor_property_type es obligatorio: AOSP tiene un neverallow que prohibe
# tocar archivos de props de tipo property_type si el tipo no esta en
# system/product/vendor_property_type. Sin el atributo, la politica no compila.
type vendor_mot_dolby_prop, property_type, vendor_property_type;

# --- Binder entre clientes y servicio (hay callbacks en los dos sentidos) ---
allow hal_aidl_dms_client hal_aidl_dms_server:binder { call transfer };
allow hal_aidl_dms_server hal_aidl_dms_client:binder { call transfer };
allow hal_aidl_dms_client hal_aidl_dms_server:fd use;

# --- Registro y busqueda del servicio ---
allow hal_aidl_dms_server hal_aidl_dms_service:service_manager { add find };
allow hal_aidl_dms_client hal_aidl_dms_service:service_manager find;

# --- Servicemanager ---
# El servicio se registra en servicemanager y servicemanager verifica el
# proceso antes de aceptarlo. Sin estas reglas el servicio NO puede registrarse,
# aborta ("Check failed: status == STATUS_OK") y init lo reinicia en bucle: eso
# fue exactamente lo que paso en la build del 19-09. Son las mismas reglas que
# trae el stock (sacadas de su vendor_sepolicy.cil).
allow hal_aidl_dms_default servicemanager:binder { call transfer };
allow servicemanager hal_aidl_dms_default:binder { call transfer };
allow servicemanager hal_aidl_dms_default:dir search;
allow servicemanager hal_aidl_dms_default:file { read open };
allow servicemanager hal_aidl_dms_default:process getattr;

# --- Datos propios: /data/vendor/dolby (lo crea el rc del servicio, media:media) ---
allow hal_aidl_dms_default vendor_data_file:dir { open read write getattr add_name remove_name search ioctl lock };
allow hal_aidl_dms_default vendor_data_file:file { open read write create getattr setattr lock append unlink rename map ioctl };
allow hal_aidl_dms_default vendor_data_file:lnk_file { read getattr };

# --- Lectura de las props de Dolby ---
# Ojo: a la app (platform_app) NO se le puede dar lectura de estas props.
# AOSP tiene un neverallow que lo prohibe y no se puede esquivar con atributos
# (en el stock de Moto si existe esa regla porque ellos pueden tocar su AOSP).
# La app no la necesita: controla Dolby por la API de efectos de audio.
allow hal_aidl_dms_default vendor_mot_dolby_prop:file { read getattr map open };
allow hal_audio_default vendor_mot_dolby_prop:file { read getattr map open };
allow vendor_init vendor_mot_dolby_prop:property_service set;
allow vendor_init vendor_mot_dolby_prop:file { read getattr map open };

# --- Clientes: audioserver (efecto DAP) y la app de la UI (platform_app) ---
hal_client_domain(hal_audio_default, hal_aidl_dms)
hal_client_domain(platform_app, hal_aidl_dms)
