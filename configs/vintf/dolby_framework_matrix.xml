<?xml version="1.0" encoding="utf-8"?>
<!--
  Matriz de compatibilidad del HAL de Dolby (vendor.dolby.dms, AIDL).

  Por que hace falta: el servicio se declara en su propio fragmento
  (/vendor/etc/vintf/manifest/dms-service.xml, igual que en la ROM stock), y el
  chequeo de compatibilidad del OTA exige que todo HAL del equipo este en alguna
  matriz. Al no ser un HAL del framework, va aca y como opcional: el sistema
  arranca sin el, pero si esta, se usa.

  Formato tomado de hardware/qcom-caf/common/compatibility_matrix_aidl.xml.
-->
<compatibility-matrix version="1.0" type="framework">
    <hal format="aidl" optional="true">
        <name>vendor.dolby.dms</name>
        <version>1</version>
        <fqname>IDms/default</fqname>
    </hal>
</compatibility-matrix>
