# Audio
audio.record.delay=100
audio.sys.mute.latency.factor=2
audio.sys.noisy.broadcast.delay=500
audio.sys.offload.pstimeout.secs=3
audio.sys.routing.latency=0
ro.audio.monitorWindowRotation=true
ro.audio.relative_volume=true

# Esim menu
esim.enable_esim_system_ui_by_default=true
masterclear.allow_retain_esim_profiles_after_fdr=true

# Media
media.stagefright.audio.deep=false

# Motorola
ro.mot.build.customerid=global

# Radio
ro.vendor.radio.imei.sv=4

import /product/product.${ro.boot.hardware.sku}.prop
ro.telephony.esim_slot_id=1

# Moto Camera: perfil multimedia de la stock (arregla el cierre al entrar a video).
# Va en product y NO en vendor: Treble descarta esta propiedad si la define vendor.
media.settings.xml=/vendor/etc/media_profiles_vendor.xml
